// Development environment: everything of devcontainer-classroom-web-advanced
// (AI assistance, ESLint, Vitest, Playwright, HTML validation) without hidden
// folders, plus the GitHub CLI, GitHub Actions and the Dev Container CLI.
// Extends ghcr.io/majikmate/devcontainer-base:2 (see .devcontainer/Dockerfile).
// Formatting (Prettier, standard style, Tailwind CSS class sorting) comes from
// the base image.
// Documentation: https://github.com/majikmate/devcontainer-dev#readme
{
  "name": "Development Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Install the newest Dev Container CLI when the container is created
  "updateContentCommand": "npm install -g @devcontainers/cli",
  // Development-specific VS Code configuration (added to the base configuration)
  "customizations": {
    "vscode": {
      "extensions": [
        // AI: GitHub Copilot (chat, inline suggestions) is built into VS Code
        // and enabled in this image; sign in with a GitHub account.
        // GitHub Actions workflows
        "github.vscode-github-actions",
        // Code quality
        "dbaeumer.vscode-eslint",
        // Issues and pull requests (used by the githubIssues/githubPullRequests settings)
        "github.vscode-pull-request-github",
        // Web development
        "ms-vscode.live-server",
        "tyriar.lorem-ipsum",
        "bradlc.vscode-tailwindcss",
        "r5n.es-js-snippets",
        // Testing
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        // ESLint: fix all problems on save (Prettier formats on save, see base image)
        "eslint.enable": true,
        "eslint.codeActionsOnSave.mode": "all",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },

        // Disable extension recommendations
        "extensions.ignoreRecommendations": true,

        // Live Preview: open in the external browser, serve the build output
        "livePreview.openPreviewTarget": "External Browser",
        "livePreview.serverRoot": "dist",

        // GitHub Issues and Pull Requests
        "githubPullRequests.remotes": ["origin"],
        "githubIssues.issueCompletionFormatScm": "${issueTitle} Fixes ${issueNumberLabel}",
        "githubIssues.issueBranchTitle": "${user}/issue${issueNumber}-${sanitizedLowercaseIssueTitle}",
        "githubIssues.workingBaseBranch": "defaultBranch",
        "githubPullRequests.createDefaultBaseBranch": "createdFromBranch",
        "githubPullRequests.createOnPublishBranch": "always"
      }
    }
  }
}
